# Copy this file to ".env.local" and fill in the values (see README.md, step 2).
# ".env.local" is private to your computer and is never uploaded to GitHub.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "Publishable" key (or the older "anon" key). NEVER put a "secret" or
# "service_role" key anywhere in this project, it is not needed.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Public web address of the shop. Local testing: http://localhost:3000
# On Vercel, set it to your real address, e.g. https://my-shop.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Currency code shown on prices (USD, EUR, GBP, MVR, INR, ...)
NEXT_PUBLIC_CURRENCY=USD

# Time zone used when showing order dates, e.g. Indian/Maldives, Europe/London, Asia/Dubai
NEXT_PUBLIC_TIMEZONE=UTC
